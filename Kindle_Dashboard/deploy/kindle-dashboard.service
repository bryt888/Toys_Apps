[Unit]
Description=Kindle Dashboard image server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tommy
WorkingDirectory=/home/tommy/kindle-dashboard
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/tommy/kindle-dashboard/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8060
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
